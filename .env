# --- Both master and node ---
ROLE=node                  # controller | master | node
HA_ENABLED=False                 # True requires PostgreSQL + Patroni
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
CLUSTER_SECRET=long-random-cluster-secret-same-on-all-machines

# --- Master/controller ---
# POSTGRES_SSLMODE=prefer
# CONTROL_PLANE_DNS=lanvault.local
# PATRONI_SCOPE=lanvault
# DATABASE_URL=postgres://lanvault:lanvault@localhost:5432/lanvault
# REPLICATION_FACTOR=2
# NODE_DEAD_AFTER_SECONDS=15
# MONITOR_INTERVAL_SECONDS=5
# MAX_UPLOAD_BYTES=104857600

# --- Node only ---
NODE_NAME=node1
NODE_ADDRESS=http://192.168.43.147:9001
NODE_DATA_DIR=./data/node1
NODE_CAPACITY_BYTES=107374182400
MASTER_URL=http://192.168.43.149:8000
HEARTBEAT_INTERVAL_SECONDS=5